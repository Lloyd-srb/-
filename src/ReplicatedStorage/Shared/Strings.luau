	["Tutorial.1.Title"] = { en = "Who is the werewolf?", th = "ใครคือหมาป่า?" },
	["Tutorial.1.Body"] = {
		en = "Up to 12 villagers live here, and one of them is secretly a werewolf. The village must find it before it eats everyone. Nobody knows anyone's role.",
		th = "หมู่บ้านนี้มีชาวบ้านไม่เกิน 12 คน และหนึ่งในนั้นคือหมาป่าที่ปลอมตัวอยู่ ชาวบ้านต้องหาให้เจอก่อนจะถูกกินหมด ไม่มีใครรู้บทของคนอื่น",
	},
	["Tutorial.2.Title"] = { en = "The day", th = "กลางวัน" },
	["Tutorial.2.Body"] = {
		en = "Do your task of the day for coins. After 3 minutes anyone can ring the bell on the meeting table. At the meeting everyone votes; at least 2 votes are needed to throw someone out.",
		th = "ทำภารกิจประจำวันเพื่อรับ coin ผ่านไป 3 นาทีใครก็กดระฆังที่โต๊ะประชุมได้ ในที่ประชุมทุกคนโหวต ต้องได้อย่างน้อย 2 เสียงถึงจะไล่ใครออกได้",
	},
	["Tutorial.3.Title"] = { en = "The night", th = "กลางคืน" },
	["Tutorial.3.Body"] = {
		en = "At night everyone is sent into a house. The werewolf breaks doors and searches beds and wardrobes. Hide under the bed or in the wardrobe! The monster can always see you in the forest. Be careful!",
		th = "ตอนกลางคืนทุกคนถูกส่งเข้าบ้าน หมาป่าพังประตูและค้นเตียงกับตู้ ซ่อนใต้เตียงหรือในตู้ให้ดี! ถ้าอยู่ในป่า มอนสเตอร์มองเห็นคุณได้เสมอ ระวังตัวด้วย!",
	},
	["Tutorial.4.Title"] = { en = "Roles", th = "บทบาท" },
	["Tutorial.4.Body"] = {
		en = "Before the match, pick 3 roles you own; you get one of them. Each role has a power. Use it with caution: the one you're helping might not be on your side!",
		th = "ก่อนเริ่มเกมเลือก 3 บทที่คุณมี แล้วจะได้หนึ่งในนั้น แต่ละบทมีพลังพิเศษ ใช้อย่างระวัง เพราะคนที่คุณช่วยอาจไม่ได้อยู่ฝั่งคุณ!",
	},
	["Tutorial.5.Title"] = { en = "Special roles", th = "บทพิเศษ" },
	["Tutorial.5.Body"] = {
		en = "They win by their own rules. They're not on your side, so don't get fooled by them!",
		th = "พวกเขาชนะด้วยเงื่อนไขของตัวเอง ไม่ได้อยู่ฝั่งคุณ อย่าหลงกลพวกเขา!",
	},
	["Tutorial.6.Title"] = { en = "Survive!", th = "เอาตัวรอด!" },
	["Tutorial.6.Body"] = {
		en = "Survive the nights as long as you can, until the wolves are finished! Good luck!",
		th = "เอาตัวรอดในแต่ละคืนให้นานที่สุด จนกว่าหมาป่าจะหมดไป! โชคดี!",
